def extract_skills_from_text(text: str) -> List[str]:
    lower = text.lower()
    found = set()
    for alias, canonical in SKILL_SYNONYMS.items():
        pattern = r"(^|[^a-z0-9])" + re.escape(alias) + r"([^a-z0-9]|$)"
        if re.search(pattern, lower):
            found.add(canonical)
    return sorted(found)


@app.get("/api/v1/health")
