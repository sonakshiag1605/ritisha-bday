@app.post("/api/v1/resumes/parse")
async def parse_resume(file: UploadFile = File(...)):
    content = await file.read()
    text = ""
    if file.filename.lower().endswith(".pdf"):
        reader = PdfReader(io.BytesIO(content))
        text = "\\n".join(page.extract_text() or "" for page in reader.pages)
    else:
        text = content.decode("utf-8", errors="ignore")

    skills = extract_skills_from_text(text)
    return {
        "filename": file.filename,
        "extracted_skills": skills,
        "word_count": len(text.split()),
        "preview": text[:1000],
    }


@app.post("/api/v1/matches")
def match_jobs(payload: MatchRequest):
    cand_skills = {s.lower() for s in payload.skills}
    results = []
    for job in JOBS_DB:
        req = job["requiredSkills"]
        matched = [s for s in req if s.lower() in cand_skills]
        missing = [s for s in req if s.lower() not in cand_skills]
        skill_pct = round((len(matched) / max(1, len(req))) * 100)
        exp_pct = 100 if payload.experience_years >= job["minExperience"] else 70
        overall = round(skill_pct * 0.7 + exp_pct * 0.3)
        results.append({
            "job": job,
            "match_score": overall,
            "matched_skills": matched,
            "missing_skills": missing,
        })
    results.sort(key=lambda x: x["match_score"], reverse=True)
    return {"matches": results}


@app.post("/api/v1/assessments/submit")
def submit_assessment(payload: AssessmentSubmitRequest):
    spec = ASSESSMENTS_DB.get(payload.assessment_id)
    if not spec:
        raise HTTPException(status_code=404, detail="Assessment not found")
    key = spec["answer_key"]
    correct = sum(1 for idx, ans in key.items() if payload.answers.get(idx) == ans)
    score_pct = round((correct / len(key)) * 100)
    passed = score_pct >= 67
    return {
        "assessment_id": payload.assessment_id,
        "skill_unlocked": spec["skill"] if passed else None,
        "score_pct": score_pct,
        "passed": passed,
    }


@app.post("/api/v1/chat")
def career_copilot_chat(payload: ChatRequest):
    matches = match_jobs(MatchRequest(skills=payload.skills, experience_years=payload.experience_years))["matches"]
    top = matches[0] if matches else None
    missing = sorted({sk for m in matches for sk in m["missing_skills"]})
    reply = (
        f"Based on your {len(payload.skills)} verified skills, your top match is "
        f"{top['job']['company']} ({top['match_score']}%). "
        f"Closing gaps in {', '.join(missing[:3]) or 'System Design'} will boost your eligibility further."
    )
    return {"reply": reply, "top_match": top, "missing_skills": missing}
